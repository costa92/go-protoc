[Unit]
Description=MariaDB database server
Documentation=man:mysqld(8)
Documentation=https://mariadb.com/kb/en/
After=network.target
ConditionPathExists=/etc/mysql/mariadb.conf.d/50-server.cnf

[Service]
Type=notify
User=mysql
Group=mysql

# Execute pre and post scripts as root, otherwise do it as User
PermissionsStartOnly=true

# Needed to create system tables etc.
ExecStartPre=/usr/bin/install -m 755 -o mysql -g root -d /var/run/mysqld

# Start main service
ExecStart=/usr/sbin/mysqld

# Don't signal the main service on reload
ExecReload=/bin/kill -s HUP $MAINPID

KillSignal=SIGTERM

# Don't want to see an automated SIGKILL ever
SendSIGKILL=no

# Restart crashed server only, on-failure would also restart, for example, when
# my.cnf contains unknown variable
Restart=on-abort
RestartSec=5s

UMask=007

# Give a reasonable amount of time for the server to start up/shut down
TimeoutSec=300

# Place temp files in a secure directory, not /tmp
PrivateTmp=yes

# Security settings
NoNewPrivileges=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict

# Data and configuration directories
ReadWritePaths=/var/lib/mysql
ReadWritePaths=/var/log/mysql
ReadWritePaths=/var/run/mysqld
ReadWritePaths=/run/mysqld

# Resource limits
LimitNOFILE=65535
LimitMEMLOCK=infinity

# Additional security
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictNamespaces=yes

[Install]
WantedBy=multi-user.target
Alias=mysql.service
Alias=mysqld.service