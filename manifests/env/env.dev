#!/usr/bin/env bash
export DEFAULT_PROJ_ROOT_DIR=$(dirname "${BASH_SOURCE[0]}")/..

export PROJ_ROOT_DIR=${PROJ_ROOT_DIR:-${DEFAULT_PROJ_ROOT_DIR}} #  项目源码根目录

# 生成文件存放目录
export LOCAL_OUTPUT_ROOT=${PROJ_ROOT_DIR}/_output

# 组件的统一访问 IP 地址，通常需要配置为安装机器的 IP 地址
export PROJ_ACCESS_HOST=${PROJ_ACCESS_HOST:-127.0.0.1}
# 组件的统一访问端口前缀
export PROJ_ACCESS_PORT_PREFIX=${PROJ_ACCESS_PORT_PREFIX:-""}

# 设置 Proj 项目统一的用户名/密码，方便记忆
export PROJ_USERNAME=proj
export PROJ_PASSWORD='proj(#)666'

# Linux系统 going 用户
export LINUX_USERNAME=going
# Linux root & going 用户密码
# export LINUX_PASSWORD=${PROJ_PASSWORD}
export LINUX_PASSWORD='longqiuhong'

#
# proj 依赖存储组件数据存放目录
export PROJ_THIRDPARTY_INSTALL_DIR=${PROJ_ROOT_DIR}/_thirdparty


# Redis 配置信息
export PROJ_REDIS_HOST=${PROJ_REDIS_HOST:-${PROJ_ACCESS_HOST}} # Redis 主机地址
export PROJ_REDIS_PORT=${PROJ_ACCESS_PORT_PREFIX}6379
export PROJ_REDIS_ADDR=${PROJ_REDIS_HOST}:${PROJ_REDIS_PORT}
export PROJ_REDIS_DATABASE=0 # Redis 主机地址
export PROJ_REDIS_USERNAME=${PROJ_USERNAME} # Redis 用户名
export PROJ_REDIS_PASSWORD=${PROJ_PASSWORD} # Redis 密码


# MariaDB 配置信息
export PROJ_MYSQL_HOST=${PROJ_MYSQL_HOST:-${PROJ_ACCESS_HOST}} # MariaDB 主机地址
export PROJ_MYSQL_PORT=${PROJ_ACCESS_PORT_PREFIX}3306
export PROJ_MYSQL_ADDR=${PROJ_MYSQL_HOST}:${PROJ_MYSQL_PORT}
export PROJ_MYSQL_ADMIN_USERNAME=root # MariaDB root 用户
export PROJ_MYSQL_ADMIN_PASSWORD=${PROJ_PASSWORD} # MariaDB root 用户密码
export PROJ_MYSQL_DATABASE=proj # MariaDB onex 应用使用的数据库名
export PROJ_MYSQL_USERNAME=${PROJ_USERNAME} # onex 数据库用户名
export PROJ_MYSQL_PASSWORD=${PROJ_PASSWORD} # onex 数据库用户名
export PROJ_MYSQL_LOG_LEVEL=1 # 数据库日志级别，1 为最低，4 为最高

# MongoDB 配置
export PROJ_MONGO_HOST=${PROJ_MONGO_HOST:-${PROJ_ACCESS_HOST}} # MongoDB 地址
export PROJ_MONGO_PORT=27017 # MongoDB 端口
export PROJ_MONGO_URL=${PROJ_MONGO_HOST}:${PROJ_MONGO_PORT} # MongoDB URL
export PROJ_MONGO_ADMIN_USERNAME=root # MongoDB root 用户
export PROJ_MONGO_ADMIN_PASSWORD=${PROJ_PASSWORD} # MongoDB root 用户密码
export PROJ_MONGO_DATABASE=proj # MongoDB 用户名
export PROJ_MONGO_COLLECTION=audit # MongoDB 密码
export PROJ_MONGO_USERNAME=${PROJ_USERNAME} # MongoDB 用户名
export PROJ_MONGO_PASSWORD=${PROJ_PASSWORD} # MongoDB 密码
export PROJ_MONGO_TIMEOUT=30s # MongoDB 密码


# Kafka 配置
export PROJ_KAFKA_HOST=${PROJ_KAFKA_HOST:-${PROJ_ACCESS_HOST}}
export PROJ_KAFKA_PORT=${PROJ_ACCESS_PORT_PREFIX}9092
export PROJ_KAFKA_BROKERS=${PROJ_KAFKA_HOST}:${PROJ_KAFKA_PORT}
export PROJ_KAFKA_TOPIC=audit
export PROJ_KAFKA_TIMEOUT=3s

# etcd 配置
export PROJ_ETCD_HOST=${PROJ_ETCD_HOST:-${PROJ_ACCESS_HOST}} # etcd 主机地址
export PROJ_ETCD_PORT=${PROJ_ACCESS_PORT_PREFIX}2379 # etcd 客户端端口
export PROJ_ETCD_PEER_PORT=${PROJ_ACCESS_PORT_PREFIX}2380 # etcd 对等端口
export PROJ_ETCD_ADDR=${PROJ_ETCD_HOST}:${PROJ_ETCD_PORT} # etcd 连接地址
export PROJ_ETCD_DATA_DIR=${PROJ_THIRDPARTY_INSTALL_DIR}/etcd # etcd 数据目录
export PROJ_ETCD_VERSION=v3.5.12 # etcd 版本

# Jaeger 配置
export PROJ_JAEGER_HOST=${PROJ_JAEGER_HOST:-${PROJ_ACCESS_HOST}} # Jaeger 主机地址
export PROJ_JAEGER_UI_PORT=${PROJ_ACCESS_PORT_PREFIX}16686 # Jaeger UI 端口
export PROJ_JAEGER_COLLECTOR_PORT=${PROJ_ACCESS_PORT_PREFIX}14268 # Jaeger 收集器端口
export PROJ_JAEGER_AGENT_PORT=${PROJ_ACCESS_PORT_PREFIX}6831 # Jaeger 代理端口 (UDP)
export PROJ_JAEGER_ADDR=${PROJ_JAEGER_HOST}:${PROJ_JAEGER_UI_PORT} # Jaeger UI 连接地址
export PROJ_JAEGER_DATA_DIR=${PROJ_THIRDPARTY_INSTALL_DIR}/jaeger # Jaeger 数据目录
export PROJ_JAEGER_VERSION=1.52.0 # Jaeger 版本

# Grafana 配置
export PROJ_GRAFANA_HOST=${PROJ_GRAFANA_HOST:-${PROJ_ACCESS_HOST}} # Grafana 主机地址
export PROJ_GRAFANA_PORT=${PROJ_ACCESS_PORT_PREFIX}3000 # Grafana Web UI 端口
export PROJ_GRAFANA_ADDR=${PROJ_GRAFANA_HOST}:${PROJ_GRAFANA_PORT} # Grafana 连接地址
export PROJ_GRAFANA_ADMIN_USER=admin # Grafana 管理员用户名
export PROJ_GRAFANA_ADMIN_PASSWORD=${PROJ_PASSWORD} # Grafana 管理员密码
export PROJ_GRAFANA_DATA_DIR=${PROJ_THIRDPARTY_INSTALL_DIR}/grafana # Grafana 数据目录
export PROJ_GRAFANA_VERSION=10.2.4 # Grafana 版本

# Prometheus 配置
export PROJ_PROMETHEUS_HOST=${PROJ_PROMETHEUS_HOST:-${PROJ_ACCESS_HOST}} # Prometheus 主机地址
export PROJ_PROMETHEUS_PORT=${PROJ_ACCESS_PORT_PREFIX}9090 # Prometheus Web UI 端口
export PROJ_PROMETHEUS_ADDR=${PROJ_PROMETHEUS_HOST}:${PROJ_PROMETHEUS_PORT} # Prometheus 连接地址
export PROJ_PROMETHEUS_DATA_DIR=${PROJ_THIRDPARTY_INSTALL_DIR}/prometheus # Prometheus 数据目录
export PROJ_PROMETHEUS_CONFIG_DIR=${PROJ_THIRDPARTY_INSTALL_DIR}/prometheus/config # Prometheus 配置目录
export PROJ_PROMETHEUS_VERSION=2.48.1 # Prometheus 版本

# AlertManager 配置
export PROJ_ALERTMANAGER_HOST=${PROJ_ALERTMANAGER_HOST:-${PROJ_ACCESS_HOST}} # AlertManager 主机地址
export PROJ_ALERTMANAGER_PORT=${PROJ_ACCESS_PORT_PREFIX}9093 # AlertManager Web UI 端口
export PROJ_ALERTMANAGER_ADDR=${PROJ_ALERTMANAGER_HOST}:${PROJ_ALERTMANAGER_PORT} # AlertManager 连接地址
export PROJ_ALERTMANAGER_DATA_DIR=${PROJ_THIRDPARTY_INSTALL_DIR}/alertmanager # AlertManager 数据目录
export PROJ_ALERTMANAGER_CONFIG_DIR=${PROJ_THIRDPARTY_INSTALL_DIR}/alertmanager/config # AlertManager 配置目录
export PROJ_ALERTMANAGER_VERSION=0.26.0 # AlertManager 版本