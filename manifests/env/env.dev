#!/usr/bin/env bash
export DEFAULT_PROJ_ROOT_DIR=$(dirname "${BASH_SOURCE[0]}")/..

export PROJ_ROOT_DIR=${PROJ_ROOT_DIR:-${DEFAULT_PROJ_ROOT_DIR}} #  项目源码根目录

# 生成文件存放目录
export LOCAL_OUTPUT_ROOT=${PROJ_ROOT_DIR}/_output

# 组件的统一访问 IP 地址，通常需要配置为安装机器的 IP 地址
export PROJ_ACCESS_HOST=${PROJ_ACCESS_HOST:-127.0.0.1}
# 组件的统一访问端口前缀
export PROJ_ACCESS_PORT_PREFIX=${PROJ_ACCESS_PORT_PREFIX:-""}

# 设置 Proj 项目统一的用户名/密码，方便记忆
export PROJ_USERNAME=proj
export PROJ_PASSWORD='proj(#)666'

# Linux系统 going 用户
export LINUX_USERNAME=going
# Linux root & going 用户密码
# export LINUX_PASSWORD=${PROJ_PASSWORD}
export LINUX_PASSWORD='longqiuhong'

#
# proj 依赖存储组件数据存放目录
export PROJ_THIRDPARTY_INSTALL_DIR=${PROJ_ROOT_DIR}/_thirdparty


# Redis 配置信息
export PROJ_REDIS_HOST=${PROJ_REDIS_HOST:-${PROJ_ACCESS_HOST}} # Redis 主机地址
export PROJ_REDIS_PORT=${PROJ_ACCESS_PORT_PREFIX}6379
export PROJ_REDIS_ADDR=${PROJ_REDIS_HOST}:${PROJ_REDIS_PORT}
export PROJ_REDIS_DATABASE=0 # Redis 主机地址
export PROJ_REDIS_USERNAME=${PROJ_USERNAME} # Redis 用户名
export PROJ_REDIS_PASSWORD=${PROJ_PASSWORD} # Redis 密码


# MariaDB 配置信息
export PROJ_MYSQL_HOST=${PROJ_MYSQL_HOST:-${PROJ_ACCESS_HOST}} # MariaDB 主机地址
export PROJ_MYSQL_PORT=${PROJ_ACCESS_PORT_PREFIX}3306
export PROJ_MYSQL_ADDR=${PROJ_MYSQL_HOST}:${PROJ_MYSQL_PORT}
export PROJ_MYSQL_ADMIN_USERNAME=root # MariaDB root 用户
export PROJ_MYSQL_ADMIN_PASSWORD=${PROJ_PASSWORD} # MariaDB root 用户密码
export PROJ_MYSQL_DATABASE=proj # MariaDB onex 应用使用的数据库名
export PROJ_MYSQL_USERNAME=${PROJ_USERNAME} # onex 数据库用户名
export PROJ_MYSQL_PASSWORD=${PROJ_PASSWORD} # onex 数据库用户名
export PROJ_MYSQL_LOG_LEVEL=1 # 数据库日志级别，1 为最低，4 为最高

# MongoDB 配置
export PROJ_MONGO_HOST=${PROJ_MONGO_HOST:-${PROJ_ACCESS_HOST}} # MongoDB 地址
export PROJ_MONGO_PORT=27017 # MongoDB 端口
export PROJ_MONGO_URL=${PROJ_MONGO_HOST}:${PROJ_MONGO_PORT} # MongoDB URL
export PROJ_MONGO_ADMIN_USERNAME=root # MongoDB root 用户
export PROJ_MONGO_ADMIN_PASSWORD=${PROJ_PASSWORD} # MongoDB root 用户密码
export PROJ_MONGO_DATABASE=proj # MongoDB 用户名
export PROJ_MONGO_COLLECTION=audit # MongoDB 密码
export PROJ_MONGO_USERNAME=${PROJ_USERNAME} # MongoDB 用户名
export PROJ_MONGO_PASSWORD=${PROJ_PASSWORD} # MongoDB 密码
export PROJ_MONGO_TIMEOUT=30s # MongoDB 密码


# Kafka 配置
export PROJ_KAFKA_HOST=${PROJ_KAFKA_HOST:-${PROJ_ACCESS_HOST}}
export PROJ_KAFKA_PORT=${PROJ_ACCESS_PORT_PREFIX}9092
export PROJ_KAFKA_BROKERS=${PROJ_KAFKA_HOST}:${PROJ_KAFKA_PORT}
export PROJ_KAFKA_TOPIC=audit
export PROJ_KAFKA_TIMEOUT=3s