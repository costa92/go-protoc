#!/usr/bin/env bash
# 开发环境配置文件
# 基于 env.base，设置开发环境特定配置

# 设置环境为开发
export PROJ_ENVIRONMENT=development

# 加载基础配置
ENV_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${ENV_DIR}/env.base"

# 开发环境特定覆盖
export PROJ_ENV_SHORT="dev"

# 开发环境专用配置
export PROJ_USERNAME=dev-user
export PROJ_PASSWORD='dev(#)123'

# 开发环境的数据库配置
export MYSQL_DATABASE=dev_${PROJ_NAME}
export MARIADB_DATABASE=dev_${PROJ_NAME}
export MONGODB_DATABASE=dev_${PROJ_NAME}

# 开发环境资源限制
export REDIS_MAX_MEMORY=512m
export NACOS_MAX_MEMORY=1g
export NACOS_JVM_XMS=512m
export NACOS_JVM_XMX=1g
export NACOS_JVM_XMN=128m

echo "✅ 开发环境配置已加载 - 网络: ${PROJ_NETWORK_NAME}"