# =============================================================================
# 8. 模板兼容性配置 (Template Compatibility Configuration)
# =============================================================================

# --- 容器命名兼容性配置 ---
# 新格式: ${PROJ_PREFIX}_service_${PROJ_ENVIRONMENT} (已在第4节定义)
# 兼容格式: ${PROJ_PREFIX}-service (保持向后兼容)
export CONTAINER_NAME_REDIS=${PROJ_PREFIX}-redis
export CONTAINER_NAME_MYSQL=${PROJ_PREFIX}-mysql
export CONTAINER_NAME_MARIADB=${PROJ_PREFIX}-mariadb
export CONTAINER_NAME_MONGODB=${PROJ_PREFIX}-mongodb
export CONTAINER_NAME_ETCD=${PROJ_PREFIX}-etcd
export CONTAINER_NAME_KAFKA=${PROJ_PREFIX}-kafka
export CONTAINER_NAME_ZOOKEEPER=${PROJ_PREFIX}-zookeeper
export CONTAINER_NAME_NACOS=${PROJ_PREFIX}-nacos
export CONTAINER_NAME_PROMETHEUS=${PROJ_PREFIX}-prometheus
export CONTAINER_NAME_OTELCOL=${PROJ_PREFIX}-otelcol
export CONTAINER_NAME_VICTORIALOGS=${PROJ_PREFIX}-victorialogs

# --- Docker模板专用别名 ---
# 为Docker模板系统提供标准化变量名
export CONTAINER_NAME=${PROJ_PREFIX}-redis        # 默认容器名 (Redis兼容)
export PROJ_CONTAINER_NAME_REDIS=${PROJ_REDIS_CONTAINER_NAME}
export KAFKA_CONTAINER=${PROJ_PREFIX}-kafka       # Kafka容器名前缀
export ZOOKEEPER_CONTAINER_NAME=${PROJ_PREFIX}-zookeeper
export ZOOKEEPER_CONTAINER=${PROJ_PREFIX}-zookeeper

# --- MySQL/MariaDB 模板兼容性配置 ---
export MYSQL_DATABASE=${PROJ_MYSQL_DATABASE}
export MYSQL_USER=${PROJ_MYSQL_USERNAME}
export MYSQL_PASSWORD=${PROJ_MYSQL_PASSWORD}
export MYSQL_ROOT_PASSWORD=${PROJ_MYSQL_ADMIN_PASSWORD}
export MARIADB_DATABASE=${PROJ_MYSQL_DATABASE}
export MARIADB_USER=${PROJ_MYSQL_USERNAME}
export MARIADB_PASSWORD=${PROJ_MYSQL_PASSWORD}
export MARIADB_ROOT_PASSWORD=${PROJ_MYSQL_ADMIN_PASSWORD}

# --- Kafka 模板兼容性配置 ---
export KAFKA_BROKER_ID=${KAFKA_BROKER_ID:-1}
export KAFKA_ZOOKEEPER_CONNECT=${KAFKA_ZOOKEEPER_CONNECT:-zookeeper:2181}
export KAFKA_ADVERTISED_LISTENERS=${KAFKA_ADVERTISED_LISTENERS:-PLAINTEXT://localhost:9092}
export KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=${KAFKA_LISTENER_SECURITY_PROTOCOL_MAP:-PLAINTEXT:PLAINTEXT}
export KAFKA_INTER_BROKER_LISTENER_NAME=${KAFKA_INTER_BROKER_LISTENER_NAME:-PLAINTEXT}

# --- etcd 模板兼容性配置 ---
export ETCD_NAME=${ETCD_NAME:-etcd0}
export ETCD_DATA_DIR=${PROJ_ETCD_DATA_DIR}
export ETCD_LISTEN_CLIENT_URLS=${ETCD_LISTEN_CLIENT_URLS:-http://0.0.0.0:2379}
export ETCD_ADVERTISE_CLIENT_URLS=${ETCD_ADVERTISE_CLIENT_URLS:-http://localhost:2379}
export ETCD_LISTEN_PEER_URLS=${ETCD_LISTEN_PEER_URLS:-http://0.0.0.0:2380}
export ETCD_INITIAL_ADVERTISE_PEER_URLS=${ETCD_INITIAL_ADVERTISE_PEER_URLS:-http://localhost:2380}
export ETCD_INITIAL_CLUSTER=${ETCD_INITIAL_CLUSTER:-etcd0=http://localhost:2380}
export ETCD_INITIAL_CLUSTER_STATE=${ETCD_INITIAL_CLUSTER_STATE:-new}

# --- Nacos 模板兼容性配置 ---
export NACOS_MODE=${NACOS_MODE:-standalone}
export NACOS_AUTH_ENABLE=${NACOS_AUTH_ENABLE:-false}
export NACOS_AUTH_TOKEN=${NACOS_AUTH_TOKEN:-SecretKey012345678901234567890123456789012345678901234567890123456789}
export NACOS_AUTH_IDENTITY_KEY=${NACOS_AUTH_IDENTITY_KEY:-serverIdentity}
export NACOS_AUTH_IDENTITY_VALUE=${NACOS_AUTH_IDENTITY_VALUE:-security}

# --- 监控Exporter专用凭据配置 ---
# MySQL/MariaDB Exporter 专用用户凭据
export MYSQL_EXPORTER_USER=${MYSQL_EXPORTER_USER:-exporter}
export MYSQL_EXPORTER_PASSWORD=${MYSQL_EXPORTER_PASSWORD:-exporter123}

# Redis 凭据（如果Redis启用了密码认证）
export REDIS_PASSWORD=${REDIS_PASSWORD:-""}

echo "✅ 基础环境配置已加载 - 项目: ${PROJ_NAME}, 环境: ${PROJ_ENVIRONMENT:-未设置}, 端口前缀: '${PROJ_ACCESS_PORT_PREFIX}', 网络: ${PROJ_NETWORK_NAME}"
