#!/usr/bin/env bash
# =============================================================================
# 环境配置基础文件 (Base Environment Configuration)
# =============================================================================
#
# 变量组织规则 (Variable Organization Rules):
# 1. 路径和项目基础配置 (Path & Project Base Configuration)
# 2. 明确的固定值配置 (Explicit Fixed Value Configuration)
# 3. 第三方组件版本 (Third-party Component Versions)
# 4. 环境相关的动态配置 (Environment-specific Dynamic Configuration)
# 5. 目录结构配置 (Directory Structure Configuration)
# 6. 服务配置 (Service Configuration) - 按依赖顺序: DB -> Cache -> MQ -> Discovery -> Monitoring
# 7. 端口配置汇总 (Port Configuration Summary)
# 8. 容器命名配置 (Container Naming Configuration)
#
# =============================================================================

# =============================================================================
# 1. 路径和项目基础配置 (Path & Project Base Configuration)
# =============================================================================

# 获取脚本所在目录的绝对路径，确保路径解析正确
ENV_SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export DEFAULT_PROJ_ROOT_DIR="$(cd "${ENV_SCRIPT_DIR}/../.." && pwd)"
export PROJ_ROOT_DIR=${PROJ_ROOT_DIR:-${DEFAULT_PROJ_ROOT_DIR}}

# =============================================================================
# 2. 明确的固定值配置 (Explicit Fixed Value Configuration)
# =============================================================================

# 项目核心标识 (明确固定值)
export PROJ_NAME=go-protoc
export PROJ_PREFIX=proj
export PROJ_SERVICE_NAME=apiserver
export PROJ_SERVICE_VERSION=v2.0.0

# 网络和访问配置 (明确固定值)
export PROJ_ACCESS_HOST=127.0.0.1

# 项目凭据配置 (明确固定值)
export PROJ_USERNAME=proj
export PROJ_PASSWORD='proj(#)666'

# Linux系统用户配置 (明确固定值)
export LINUX_USERNAME=going
export LINUX_PASSWORD='longqiuhong'

# =============================================================================
# 3. 第三方组件版本 (Third-party Component Versions)
# =============================================================================

# 数据存储服务版本
export REDIS_VERSION=7.2.4
export MYSQL_VERSION=8.0.35
export MARIADB_VERSION=11.2.2
export MONGODB_VERSION=7.0.5

# 分布式系统版本
export ETCD_VERSION=3.5.10

# Kafka、Zookeeper、Nacos版本 - 平台相关配置
if [[ "$(uname)" == "Darwin" ]]; then
    # macOS - 支持ARM64架构
    export ZOOKEEPER_VERSION=7.4.0
    export KAFKA_VERSION=7.4.0
    export NACOS_VERSION=v2.5.1
    # macOS Kafka工具路径 (Confluent镜像)
    export KAFKA_TOOLS_PATH="/bin"
else
    # Linux - 使用已有镜像版本
    export ZOOKEEPER_VERSION=latest
    export KAFKA_VERSION=6.2.0
    export NACOS_VERSION=v2.1.2  # 使用本地已有镜像
    # Linux Kafka工具路径 (Confluent镜像)
    export KAFKA_TOOLS_PATH="/bin"
fi

# 监控与可观测性服务版本
export JAEGER_VERSION=1.52.0
export GRAFANA_VERSION=10.2.4
export PROMETHEUS_VERSION=2.48.1
export ALERTMANAGER_VERSION=0.26.0
export OTEL_COLLECTOR_VERSION=0.132.0
export OTELCOL_VERSION=${OTEL_COLLECTOR_VERSION}
export PYROSCOPE_VERSION=0.36.0
export VICTORIALOGS_VERSION=1.28.0
export VICTORIAMETRICS_VERSION=1.97.1

# =============================================================================
# 4. 环境相关的动态配置 (Environment-specific Dynamic Configuration)
# =============================================================================

# 环境特定的端口前缀映射
case "${PROJ_ENVIRONMENT}" in
    "development"|"dev")
        export PROJ_ENV_SHORT="dev"
        ;;
    "test"|"testing")
        export PROJ_ENV_SHORT="test"
        ;;
    "production"|"prod")
        export PROJ_ENV_SHORT="prod"
        ;;
    *)
        export PROJ_ENV_SHORT="custom"
        ;;
esac

# 环境标识符 (用于容器标签和资源标记)
export PROJ_ENV_LABEL="env=${PROJ_ENVIRONMENT}"
export PROJ_ENV_PREFIX="${PROJ_PREFIX}-${PROJ_ENVIRONMENT}"

# 环境特定的网络配置
export PROJ_NETWORK_NAME=${PROJ_NETWORK_NAME:-"${PROJ_PREFIX}-network"}

# 环境特定的数据卷前缀
export PROJ_VOLUME_PREFIX="${PROJ_PREFIX}-${PROJ_ENV_SHORT}"

# 容器命名规则 (格式: ${PROJ_PREFIX}-${SERVICE_NAME})
# 所有容器名统一使用 CONTAINER_NAME_* 变量

# =============================================================================
# 5. 目录结构配置 (Directory Structure Configuration)
# =============================================================================

# 项目输出目录
export LOCAL_OUTPUT_ROOT=${PROJ_ROOT_DIR}/_output

# 第三方服务安装目录
export PROJ_THIRDPARTY_INSTALL_DIR=${PROJ_ROOT_DIR}/_thirdparty

# 数据库服务配置目录
export PROJ_REDIS_CONFIG_DIR=${PROJ_REDIS_CONFIG_DIR:-"${PROJ_THIRDPARTY_INSTALL_DIR}/redis/config"}
export PROJ_REDIS_DATA_DIR=${PROJ_REDIS_DATA_DIR:-"${PROJ_THIRDPARTY_INSTALL_DIR}/redis/data"}
export PROJ_REDIS_LOG_DIR=${PROJ_REDIS_LOG_DIR:-"${PROJ_THIRDPARTY_INSTALL_DIR}/redis/logs"}
export PROJ_MYSQL_CONFIG_DIR=${PROJ_MYSQL_CONFIG_DIR:-"${PROJ_THIRDPARTY_INSTALL_DIR}/mysql/config"}
export PROJ_MYSQL_DATA_DIR=${PROJ_MYSQL_DATA_DIR:-"${PROJ_THIRDPARTY_INSTALL_DIR}/mysql/data"}
export PROJ_MARIADB_CONFIG_DIR=${PROJ_MARIADB_CONFIG_DIR:-"${PROJ_THIRDPARTY_INSTALL_DIR}/mariadb/config"}
export PROJ_MARIADB_DATA_DIR=${PROJ_MARIADB_DATA_DIR:-"${PROJ_THIRDPARTY_INSTALL_DIR}/mariadb/data"}
export PROJ_MARIADB_LOG_DIR=${PROJ_MARIADB_LOG_DIR:-"${PROJ_THIRDPARTY_INSTALL_DIR}/mariadb/logs"}
export PROJ_MONGODB_CONFIG_DIR=${PROJ_MONGODB_CONFIG_DIR:-"${PROJ_THIRDPARTY_INSTALL_DIR}/mongodb/config"}
export PROJ_MONGODB_DATA_DIR=${PROJ_MONGODB_DATA_DIR:-"${PROJ_THIRDPARTY_INSTALL_DIR}/mongodb/data"}
export PROJ_MONGODB_LOG_DIR=${PROJ_MONGODB_LOG_DIR:-"${PROJ_THIRDPARTY_INSTALL_DIR}/mongodb/logs"}

# 分布式系统配置目录
export PROJ_ETCD_CONFIG_DIR=${PROJ_ETCD_CONFIG_DIR:-"${PROJ_THIRDPARTY_INSTALL_DIR}/etcd/config"}
export PROJ_ETCD_DATA_DIR=${PROJ_ETCD_DATA_DIR:-"${PROJ_THIRDPARTY_INSTALL_DIR}/etcd/data"}
export PROJ_ETCD_LOG_DIR=${PROJ_ETCD_LOG_DIR:-"${PROJ_THIRDPARTY_INSTALL_DIR}/etcd/logs"}
export PROJ_KAFKA_CONFIG_DIR=${PROJ_KAFKA_CONFIG_DIR:-"${PROJ_THIRDPARTY_INSTALL_DIR}/kafka/config"}
export PROJ_KAFKA_DATA_DIR=${PROJ_KAFKA_DATA_DIR:-"${PROJ_THIRDPARTY_INSTALL_DIR}/kafka/data"}
export PROJ_KAFKA_LOG_DIR=${PROJ_KAFKA_LOG_DIR:-"${PROJ_THIRDPARTY_INSTALL_DIR}/kafka/logs"}
export PROJ_ZOOKEEPER_CONFIG_DIR=${PROJ_ZOOKEEPER_CONFIG_DIR:-"${PROJ_THIRDPARTY_INSTALL_DIR}/zookeeper/config"}
export PROJ_ZOOKEEPER_DATA_DIR=${PROJ_ZOOKEEPER_DATA_DIR:-"${PROJ_THIRDPARTY_INSTALL_DIR}/zookeeper/data"}
export PROJ_ZOOKEEPER_LOG_DIR=${PROJ_ZOOKEEPER_LOG_DIR:-"${PROJ_THIRDPARTY_INSTALL_DIR}/zookeeper/logs"}
export PROJ_NACOS_CONFIG_DIR=${PROJ_NACOS_CONFIG_DIR:-"${PROJ_THIRDPARTY_INSTALL_DIR}/nacos/config"}
export PROJ_NACOS_DATA_DIR=${PROJ_NACOS_DATA_DIR:-"${PROJ_THIRDPARTY_INSTALL_DIR}/nacos/data"}
export PROJ_NACOS_LOG_DIR=${PROJ_NACOS_LOG_DIR:-"${PROJ_THIRDPARTY_INSTALL_DIR}/nacos/logs"}

# 可观测性服务配置目录
export PROJ_JAEGER_DATA_DIR=${PROJ_JAEGER_DATA_DIR:-"${PROJ_THIRDPARTY_INSTALL_DIR}/jaeger/data"}
export PROJ_GRAFANA_CONFIG_DIR=${PROJ_GRAFANA_CONFIG_DIR:-"${PROJ_THIRDPARTY_INSTALL_DIR}/grafana/config"}
export PROJ_GRAFANA_DATA_DIR=${PROJ_GRAFANA_DATA_DIR:-"${PROJ_THIRDPARTY_INSTALL_DIR}/grafana/data"}
export PROJ_PROMETHEUS_CONFIG_DIR=${PROJ_PROMETHEUS_CONFIG_DIR:-"${PROJ_THIRDPARTY_INSTALL_DIR}/prometheus/config"}
export PROJ_PROMETHEUS_DATA_DIR=${PROJ_PROMETHEUS_DATA_DIR:-"${PROJ_THIRDPARTY_INSTALL_DIR}/prometheus/data"}
export PROJ_PROMETHEUS_LOG_DIR=${PROJ_PROMETHEUS_LOG_DIR:-"${PROJ_PROMETHEUS_DATA_DIR}/logs"}
export PROJ_ALERTMANAGER_CONFIG_DIR=${PROJ_ALERTMANAGER_CONFIG_DIR:-"${PROJ_THIRDPARTY_INSTALL_DIR}/alertmanager/config"}
export PROJ_ALERTMANAGER_DATA_DIR=${PROJ_ALERTMANAGER_DATA_DIR:-"${PROJ_THIRDPARTY_INSTALL_DIR}/alertmanager/data"}
export PROJ_OTELCOL_CONFIG_DIR=${PROJ_OTELCOL_CONFIG_DIR:-"${PROJ_THIRDPARTY_INSTALL_DIR}/otelcol/config"}
export PROJ_OTELCOL_DATA_DIR=${PROJ_OTELCOL_DATA_DIR:-"${PROJ_THIRDPARTY_INSTALL_DIR}/otelcol/data"}
export PROJ_OTEL_AGENT_CONFIG_DIR=${PROJ_OTEL_AGENT_CONFIG_DIR:-"${PROJ_THIRDPARTY_INSTALL_DIR}/otel-agent/config"}
export PROJ_OTEL_AGENT_DATA_DIR=${PROJ_OTEL_AGENT_DATA_DIR:-"${PROJ_THIRDPARTY_INSTALL_DIR}/otel-agent/data"}
export PROJ_PYROSCOPE_CONFIG_DIR=${PROJ_PYROSCOPE_CONFIG_DIR:-"${PROJ_THIRDPARTY_INSTALL_DIR}/pyroscope/config"}
export PROJ_PYROSCOPE_DATA_DIR=${PROJ_PYROSCOPE_DATA_DIR:-"${PROJ_THIRDPARTY_INSTALL_DIR}/pyroscope/data"}
export PROJ_VICTORIALOGS_CONFIG_DIR=${PROJ_VICTORIALOGS_CONFIG_DIR:-"${PROJ_THIRDPARTY_INSTALL_DIR}/victorialogs/config"}
export PROJ_VICTORIALOGS_DATA_DIR=${PROJ_VICTORIALOGS_DATA_DIR:-"${PROJ_THIRDPARTY_INSTALL_DIR}/victorialogs/data"}
export PROJ_VICTORIALOGS_LOG_DIR=${PROJ_VICTORIALOGS_LOG_DIR:-"${PROJ_THIRDPARTY_INSTALL_DIR}/victorialogs/logs"}
export PROJ_VICTORIAMETRICS_CONFIG_DIR=${PROJ_VICTORIAMETRICS_CONFIG_DIR:-"${PROJ_THIRDPARTY_INSTALL_DIR}/victoriametrics/config"}
export PROJ_VICTORIAMETRICS_DATA_DIR=${PROJ_VICTORIAMETRICS_DATA_DIR:-"${PROJ_THIRDPARTY_INSTALL_DIR}/victoriametrics/data"}
export PROJ_VMAGENT_DATA_DIR=${PROJ_VMAGENT_DATA_DIR:-"${PROJ_THIRDPARTY_INSTALL_DIR}/vmagent/data"}
export PROJ_SENTRY_CONFIG_DIR=${PROJ_SENTRY_CONFIG_DIR:-"${PROJ_THIRDPARTY_INSTALL_DIR}/sentry/config"}
export PROJ_SENTRY_DATA_DIR=${PROJ_SENTRY_DATA_DIR:-"${PROJ_THIRDPARTY_INSTALL_DIR}/sentry/data"}

# =============================================================================
# 6. 服务配置 (Service Configuration) - 按依赖顺序: DB -> Cache -> MQ -> Discovery -> Monitoring
# =============================================================================

# --- 数据库服务配置 (Database Services) ---

# Redis 配置
export PROJ_REDIS_HOST=${PROJ_REDIS_HOST:-${PROJ_ACCESS_HOST}}
export PROJ_REDIS_PORT=6379
export PROJ_REDIS_ADDR=${PROJ_REDIS_HOST}:${PROJ_REDIS_PORT}
export PROJ_REDIS_DATABASE=0
export PROJ_REDIS_USERNAME=${PROJ_USERNAME}
export PROJ_REDIS_PASSWORD=${PROJ_PASSWORD}
export REDIS_MAX_MEMORY=1gb

# MySQL/MariaDB 配置
export PROJ_MYSQL_HOST=${PROJ_MYSQL_HOST:-${PROJ_ACCESS_HOST}}
export PROJ_MYSQL_PORT=3306
export PROJ_MYSQL_ADDR=${PROJ_MYSQL_HOST}:${PROJ_MYSQL_PORT}
export PROJ_MYSQL_ADMIN_USERNAME=root
export PROJ_MYSQL_ADMIN_PASSWORD=${PROJ_PASSWORD}
export PROJ_MYSQL_DATABASE=protoc
export PROJ_MYSQL_USERNAME=${PROJ_USERNAME}
export PROJ_MYSQL_PASSWORD=${PROJ_PASSWORD}
export PROJ_MYSQL_LOG_LEVEL=1

# MongoDB 配置
export PROJ_MONGO_HOST=${PROJ_MONGO_HOST:-${PROJ_ACCESS_HOST}}
export PROJ_MONGO_PORT=27017
export PROJ_MONGO_URL=${PROJ_MONGO_HOST}:${PROJ_MONGO_PORT}
export PROJ_MONGO_ADMIN_USERNAME=root
export PROJ_MONGO_ADMIN_PASSWORD=${PROJ_PASSWORD}
export PROJ_MONGO_DATABASE=proj
export PROJ_MONGO_COLLECTION=audit
export PROJ_MONGO_USERNAME=${PROJ_USERNAME}
export PROJ_MONGO_PASSWORD=${PROJ_PASSWORD}
export PROJ_MONGO_TIMEOUT=30s

# --- 消息队列服务配置 (Message Queue Services) ---

# Kafka 配置
export PROJ_KAFKA_HOST=${PROJ_KAFKA_HOST:-${PROJ_ACCESS_HOST}}
export PROJ_KAFKA_PORT=9092
export PROJ_KAFKA_INTERNAL_PORT=29092
export PROJ_KAFKA_BROKERS=${PROJ_KAFKA_HOST}:${PROJ_KAFKA_PORT}
export PROJ_KAFKA_INTERNAL_BROKER=${PROJ_PREFIX}-kafka:${PROJ_KAFKA_INTERNAL_PORT}
export PROJ_KAFKA_TOPIC=audit
export PROJ_KAFKA_TIMEOUT=3s

# Zookeeper 配置
export PROJ_ZOOKEEPER_HOST=${PROJ_ZOOKEEPER_HOST:-${PROJ_ACCESS_HOST}}
export PROJ_ZOOKEEPER_PORT=2181
export PROJ_ZOOKEEPER_ADDR=${PROJ_ZOOKEEPER_HOST}:${PROJ_ZOOKEEPER_PORT}

# --- 分布式协调服务配置 (Distributed Coordination Services) ---

# etcd 配置
export PROJ_ETCD_HOST=${PROJ_ETCD_HOST:-${PROJ_ACCESS_HOST}}
export PROJ_ETCD_PORT=2379
export PROJ_ETCD_PEER_PORT=2380
export PROJ_ETCD_ADDR=${PROJ_ETCD_HOST}:${PROJ_ETCD_PORT}

# Nacos 配置
export PROJ_NACOS_HOST=${PROJ_NACOS_HOST:-${PROJ_ACCESS_HOST}}
export PROJ_NACOS_PORT=8848
export PROJ_NACOS_GRPC_PORT=9848
export PROJ_NACOS_RAFT_PORT=9849
export PROJ_NACOS_ADDR=${PROJ_NACOS_HOST}:${PROJ_NACOS_PORT}
export NACOS_MAX_MEMORY=${NACOS_MAX_MEMORY:-1g}
export NACOS_MIN_MEMORY=${NACOS_MIN_MEMORY:-512m}
export NACOS_JVM_XMS=${NACOS_JVM_XMS:-512m}
export NACOS_JVM_XMX=${NACOS_JVM_XMX:-1g}
export NACOS_JVM_XMN=${NACOS_JVM_XMN:-256m}

# --- 监控与可观测性服务配置 (Monitoring & Observability Services) ---

# Jaeger 配置
export PROJ_JAEGER_HOST=${PROJ_JAEGER_HOST:-${PROJ_ACCESS_HOST}}
export PROJ_JAEGER_UI_PORT=16686
export PROJ_JAEGER_COLLECTOR_PORT=14268
export PROJ_JAEGER_AGENT_PORT=6831
export PROJ_JAEGER_GRPC_PORT=14250
export PROJ_JAEGER_ADDR=${PROJ_JAEGER_HOST}:${PROJ_JAEGER_UI_PORT}

# Grafana 配置
export PROJ_GRAFANA_HOST=${PROJ_GRAFANA_HOST:-${PROJ_ACCESS_HOST}}
export PROJ_GRAFANA_PORT=3000
export PROJ_GRAFANA_ADDR=${PROJ_GRAFANA_HOST}:${PROJ_GRAFANA_PORT}
export PROJ_GRAFANA_ADMIN_USER=admin
export PROJ_GRAFANA_ADMIN_PASSWORD=${PROJ_PASSWORD}

# Prometheus 配置
export PROJ_PROMETHEUS_HOST=${PROJ_PROMETHEUS_HOST:-${PROJ_ACCESS_HOST}}
export PROJ_PROMETHEUS_PORT=9090
export PROJ_PROMETHEUS_ADDR=${PROJ_PROMETHEUS_HOST}:${PROJ_PROMETHEUS_PORT}

# AlertManager 配置
export PROJ_ALERTMANAGER_HOST=${PROJ_ALERTMANAGER_HOST:-${PROJ_ACCESS_HOST}}
export PROJ_ALERTMANAGER_PORT=9093
export PROJ_ALERTMANAGER_ADDR=${PROJ_ALERTMANAGER_HOST}:${PROJ_ALERTMANAGER_PORT}

# OpenTelemetry Collector 配置
export PROJ_OTELCOL_HOST=${PROJ_OTELCOL_HOST:-${PROJ_ACCESS_HOST}}
export PROJ_OTELCOL_HTTP_PORT=4318
export PROJ_OTELCOL_GRPC_PORT=4317
export PROJ_OTELCOL_METRICS_PORT=8888
export PROJ_OTELCOL_HEALTH_PORT=13133

# OpenTelemetry Agent 配置 (独立端口)
export PROJ_OTEL_AGENT_HOST=${PROJ_OTEL_AGENT_HOST:-${PROJ_ACCESS_HOST}}
export PROJ_OTEL_AGENT_HTTP_PORT=4328
export PROJ_OTEL_AGENT_GRPC_PORT=4327
export PROJ_OTEL_AGENT_HEALTH_PORT=13134

# Pyroscope 配置
export PROJ_PYROSCOPE_HOST=${PROJ_PYROSCOPE_HOST:-${PROJ_ACCESS_HOST}}
export PROJ_PYROSCOPE_PORT=4040
export PROJ_PYROSCOPE_ADDR=${PROJ_PYROSCOPE_HOST}:${PROJ_PYROSCOPE_PORT}
export PROJ_PYROSCOPE_LOG_LEVEL=info

# VictoriaLogs 配置
export PROJ_VICTORIALOGS_HOST=${PROJ_VICTORIALOGS_HOST:-${PROJ_ACCESS_HOST}}
export PROJ_VICTORIALOGS_PORT=9428
export PROJ_VICTORIALOGS_ADDR=${PROJ_VICTORIALOGS_HOST}:${PROJ_VICTORIALOGS_PORT}
export VICTORIALOGS_RETENTION=${VICTORIALOGS_RETENTION:-7d}

# VictoriaMetrics 配置
export PROJ_VICTORIAMETRICS_HOST=${PROJ_VICTORIAMETRICS_HOST:-${PROJ_ACCESS_HOST}}
export PROJ_VICTORIAMETRICS_PORT=8428
export PROJ_VICTORIAMETRICS_ADDR=${PROJ_VICTORIAMETRICS_HOST}:${PROJ_VICTORIAMETRICS_PORT}

# vmagent 配置
export PROJ_VMAGENT_HOST=${PROJ_VMAGENT_HOST:-${PROJ_ACCESS_HOST}}
export PROJ_VMAGENT_PORT=8429
export PROJ_VMAGENT_ADDR=${PROJ_VMAGENT_HOST}:${PROJ_VMAGENT_PORT}

# Sentry 配置
export PROJ_SENTRY_HOST=${PROJ_SENTRY_HOST:-${PROJ_ACCESS_HOST}}
export PROJ_SENTRY_PORT=9000
export PROJ_SENTRY_WEB_PORT=${PROJ_SENTRY_PORT}
export PROJ_SENTRY_ADDR=${PROJ_SENTRY_HOST}:${PROJ_SENTRY_PORT}
export PROJ_SENTRY_POSTGRES_DB=sentry
export PROJ_SENTRY_POSTGRES_USER=sentry
export PROJ_SENTRY_POSTGRES_PASSWORD=${PROJ_PASSWORD}
export PROJ_SENTRY_REDIS_URL=redis://redis:6379/0
export PROJ_SENTRY_SECRET_KEY=$(openssl rand -hex 32 2>/dev/null || echo "sentry-default-secret-key-$(date +%s)")


# =============================================================================
# 8. 容器命名配置 (Container Naming Configuration)
# =============================================================================

# 容器命名配置 (格式: ${PROJ_PREFIX}-${SERVICE_NAME})
export CONTAINER_NAME_REDIS=${PROJ_PREFIX}-redis
export CONTAINER_NAME_MYSQL=${PROJ_PREFIX}-mysql
export CONTAINER_NAME_MARIADB=${PROJ_PREFIX}-mariadb
export CONTAINER_NAME_MONGODB=${PROJ_PREFIX}-mongodb
export CONTAINER_NAME_ETCD=${PROJ_PREFIX}-etcd
export CONTAINER_NAME_KAFKA=${PROJ_PREFIX}-kafka
export CONTAINER_NAME_ZOOKEEPER=${PROJ_PREFIX}-zookeeper
export CONTAINER_NAME_NACOS=${PROJ_PREFIX}-nacos
export CONTAINER_NAME_PROMETHEUS=${PROJ_PREFIX}-prometheus
export CONTAINER_NAME_OTELCOL=${PROJ_PREFIX}-otelcol
export CONTAINER_NAME_OTEL_COLLECTOR=${PROJ_PREFIX}-otel-collector
export CONTAINER_NAME_OTEL_AGENT=${PROJ_PREFIX}-otel-agent
export CONTAINER_NAME_VICTORIALOGS=${PROJ_PREFIX}-victorialogs

# 监控Exporter专用凭据配置
export MYSQL_EXPORTER_USER=exporter
export MYSQL_EXPORTER_PASSWORD=exporter123
export REDIS_PASSWORD=""

echo "✅ 基础环境配置已加载 - 项目: ${PROJ_NAME}, 环境: ${PROJ_ENVIRONMENT:-未设置}, 网络: ${PROJ_NETWORK_NAME}"
