#!/usr/bin/env bash
# 测试环境配置文件
# 基于 env.dev，覆盖环境特定设置

# 设置环境为测试
export PROJ_ENVIRONMENT=test

# 加载基础配置
# 获取脚本所在目录的绝对路径，然后加载同目录下的 env.base
ENV_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${ENV_DIR}/env.base"

# 测试环境特定覆盖
export PROJ_ENV_SHORT="test"

# 测试环境特殊配置
export PROJ_USERNAME=test-user
export PROJ_PASSWORD='test(#)123'

# 测试环境的数据库配置
export MYSQL_DATABASE=test_${PROJ_NAME}
export MARIADB_DATABASE=test_${PROJ_NAME}
export MONGODB_DATABASE=test_${PROJ_NAME}

echo "✅ 测试环境配置已加载 - 网络: ${PROJ_NETWORK_NAME}"