#!/usr/bin/env bash
# 生产环境配置文件
# 基于 env.dev，覆盖环境特定设置

# 设置环境为生产
export PROJ_ENVIRONMENT=production

# 加载基础配置
# 获取脚本所在目录的绝对路径，然后加载同目录下的 env.base
ENV_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${ENV_DIR}/env.base"

# 生产环境特定覆盖
export PROJ_ENV_SHORT="prod"

# 生产环境安全配置
export PROJ_USERNAME=admin
export PROJ_PASSWORD="${PROD_PASSWORD:-prod(#)999}"  # 从环境变量获取

# 生产环境的数据库配置
export MYSQL_DATABASE=${PROJ_NAME}_prod
export MARIADB_DATABASE=${PROJ_NAME}_prod
export MONGODB_DATABASE=${PROJ_NAME}_prod

# 生产环境资源限制
export REDIS_MAX_MEMORY=2g
export NACOS_MAX_MEMORY=2g
export NACOS_JVM_XMS=1g
export NACOS_JVM_XMX=2g
export NACOS_JVM_XMN=512m

echo "✅ 生产环境配置已加载 - 网络: ${PROJ_NETWORK_NAME}"